rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email in [
          "monojjin@gmail.com",
          "nollpic.official@gmail.com"
        ];
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isGuestWrite(guestId) {
      return request.resource.data.guestId == guestId
        && request.resource.data.isGuest == true;
    }

    function isCompleteResultWrite() {
      return request.resource.data.isComplete == true
        || request.resource.data.finishedTests == 5;
    }

    match /recommendedPlays/{playId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read, create, update, delete: if owns(userId) || isAdmin();

      match /children/{childId} {
        allow read, create, update, delete: if owns(userId) || isAdmin();
      }

      match /results/{resultId} {
        allow read, create, update, delete: if owns(userId) || isAdmin();
      }
    }

    match /guestUsers/{guestId} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin() || isGuestWrite(guestId);

      match /children/{childId} {
        allow read, delete: if isAdmin();
        allow create, update: if isAdmin() || isGuestWrite(guestId);
      }

      match /results/{resultId} {
        allow read, update, delete: if isAdmin();
        allow create: if isAdmin() || (isGuestWrite(guestId) && isCompleteResultWrite());
      }
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
