rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email in [
          "monojjin@gmail.com",
          "nollpic.official@gmail.com"
        ];
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isGuestWrite(guestId) {
      return !signedIn()
        && guestId.matches('guest_.*')
        && request.resource.data.isGuest == true
        && request.resource.data.guestId == guestId;
    }

    function isCompleteGuestResult(guestId) {
      return isGuestWrite(guestId)
        && (request.resource.data.isComplete == true || request.resource.data.finishedTests == 5);
    }

    function isPublicResultCreate() {
      return request.resource.data.keys().hasOnly([
          "type",
          "grade",
          "name",
          "time",
          "date",
          "createdAtMs",
          "memberType",
          "isGuest",
          "createdAt"
        ])
        && request.resource.data.type in [
          "schulte",
          "memory",
          "reaction",
          "visual",
          "flanker"
        ]
        && request.resource.data.grade is string
        && request.resource.data.grade.size() <= 20
        && request.resource.data.name == "익명"
        && request.resource.data.time is string
        && request.resource.data.time.size() <= 40
        && request.resource.data.date is string
        && request.resource.data.date.size() <= 20
        && request.resource.data.createdAtMs is number
        && request.resource.data.memberType in ["member", "guest"]
        && request.resource.data.isGuest is bool
        && request.resource.data.createdAt == request.time;
    }

    match /recommendedPlays/{playId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /testResults/{resultId} {
      allow read: if true;
      allow create: if isPublicResultCreate();
      allow update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read, create, update, delete: if owns(userId) || isAdmin();

      match /children/{childId} {
        allow read, create, update, delete: if owns(userId) || isAdmin();
      }

      match /results/{resultId} {
        allow read, create, update, delete: if owns(userId) || isAdmin();
      }
    }

    match /guestUsers/{guestId} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin() || isGuestWrite(guestId);

      match /children/{childId} {
        allow read, delete: if isAdmin();
        allow create, update: if isAdmin() || isGuestWrite(guestId);
      }

      match /results/{resultId} {
        allow read, update, delete: if isAdmin();
        allow create: if isAdmin() || isCompleteGuestResult(guestId);
      }
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
